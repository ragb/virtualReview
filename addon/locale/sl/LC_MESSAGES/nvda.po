#. Translators: Title of the Virtual Revision settings panel.
#: addon\globalPlugins\virtualRevision.py:90
msgid "Virtual Revision"
msgstr ""

#: addon\globalPlugins\virtualRevision.py:96
msgid "Play alert &beeps when reviewing UWP windows"
msgstr ""

#. Translators: Message presented in input help mode.
#: addon\globalPlugins\virtualRevision.py:162
msgid "Opens a window containing the text of the currently focused window for easy review."
msgstr "Odpre okno, ki vsebuje besedilo trenutnega okna v žarišču za lahek pregled."

#. Translators: The title of the virtual review window when the foreground window has no name, commonly seen when all windows are minimized.
#: addon\globalPlugins\virtualRevision.py:207
msgid "No title"
msgstr "Brez naslova"

#. Translators: Title of the window shown for reading text on screen via a window.
#: addon\globalPlugins\virtualRevision.py:209
#, python-brace-format
msgid "Virtual review: {screenName}"
msgstr "Navidezni pregled: {screenName}"

#. Translator: Message shown when no text can be virtualized.
#: addon\globalPlugins\virtualRevision.py:212
msgid "No text to display"
msgstr "Ni besedila za prikaz"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:21
msgid "Virtual Review"
msgstr "Navidezni Pregled"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "Provides a simple reviewable dialog of the text of the currently focused window."
msgstr "Oskrbi preprosto okno za pregled besedila v oknu, ki je v žarišču."

